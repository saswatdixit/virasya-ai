# =============================================================================
# Virasya Cultural Preservation Platform — Master Environment Template
# =============================================================================
# Copy the relevant sections to:
#   • frontend/.env.local (for React frontend development)
#   • virasya-ai/.env (for local Python CLI and studio server)
#   • Or configure in Supabase Dashboard / Vercel Project Settings.
#
# IMPORTANT: NEVER commit real API keys, passwords, or service-role keys to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT CONFIGURATION (frontend/.env.local / Vercel Settings)
# -----------------------------------------------------------------------------
# Hosted Supabase endpoint (e.g., https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous client key (Safe for browser exposure; protected by RLS)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key-here
# Note: VITE_SUPABASE_ANON_KEY is also accepted as a backward-compatible alias
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key-here

# Optional Backend API Base URL
# • Production (Vercel): Leave empty (Frontend routes directly to Supabase Edge Functions)
# • Local Dev: Leave empty (Vite dev proxy forwards /api to http://127.0.0.1:5000 if Python backend is running)
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# 2. SUPABASE EDGE FUNCTIONS & SERVERLESS SECRETS (Deno Server-Side Secrets)
# -----------------------------------------------------------------------------
# Set via: npx supabase secrets set GNANI_API_KEY=... --project-ref <project-ref>
# Gnani.ai Prisma STT REST API Key (Required by supabase/functions/transcribe-audio)
GNANI_API_KEY=your-gnani-api-key-here

# Supabase Platform Automatic Secrets (Pre-configured by Supabase in production):
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# 3. LOCAL PYTHON WORKBENCH & CLI CONFIGURATION (virasya-ai/.env)
# -----------------------------------------------------------------------------
# Gnani.ai API configuration for local CLI (virasya) and local server (virasya-web)
GNANI_API_KEY=your-gnani-api-key-here
GNANI_TIMEOUT_SECONDS=30.0

# Local Studio Server binding options (virasya_ai.web.server)
PORT=5000
VIRASYA_WEB_PORT=5000
VIRASYA_WEB_HOST=127.0.0.1

# Directory for local JSON data persistence (default: data/output)
VIRASYA_DATA_DIR=data/output

# Concurrency & worker limits for local audio transcription
VIRASYA_MAX_CONCURRENT_TRANSCRIBES=3

# Allowed CORS origins (comma-separated, or * for open development)
VIRASYA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://virasya-ai-gnani.vercel.app

# Enforce Supabase JWT Bearer token authentication on local Python backend (default: false for local dev)
VIRASYA_REQUIRE_AUTH=false

# Optional Supabase integration for Python backend (required only when VIRASYA_REQUIRE_AUTH=true)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
