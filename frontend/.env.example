# Virasya Frontend Environment Variables
# Copy this file to .env.local for local development.

# Backend API Base URL
# - In local development: Leave empty (Vite proxies /api to http://127.0.0.1:5000)
# - In frontend-only preview: Leave empty
# - In production with hosted backend: Set to your public backend URL (e.g. https://api.virasya.org)
VITE_API_BASE_URL=

# Supabase Staging Configuration (virasya-staging-temp)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://tdpeljbmicgjgxjwsvoc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key-here
