# Virasya Frontend Environment Variables
# Copy this file to .env.local to customize for your deployment.

# Backend API Base URL
# - In local development: Leave empty (Vite proxies /api to http://127.0.0.1:5000)
# - In frontend-only Vercel preview: Leave empty (Frontend runs in interactive preview mode)
# - In production with hosted backend: Set to your public backend URL (e.g., https://api.virasya.org)
VITE_API_BASE_URL=
