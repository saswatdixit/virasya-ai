# Virasya Frontend Environment Variables
# Copy this file to .env.local for local development, or set in Vercel project environment variables.
#
# Production Architecture: Serverless (Vercel SPA + Supabase Auth / Storage / Postgres / Edge Functions)
# No separate Python server deployment required.

# Supabase Configuration (Required for Production)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
# Production Project Ref: ahjmjgiyljjkxvwoubdr
VITE_SUPABASE_URL=https://ahjmjgiyljjkxvwoubdr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key-here
# Note: VITE_SUPABASE_ANON_KEY is also accepted as an alias

# Optional Backend API Base URL (Local Dev Only)
# - In local development: Leave empty (Vite dev server proxies /api to http://127.0.0.1:5000 if running Python)
# - In production: Leave empty (Virasya routes all requests directly to Supabase Edge Functions & Storage)
VITE_API_BASE_URL=

