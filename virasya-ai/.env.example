# Virasya AI Backend Environment Variables
# Copy this file to virasya-ai/.env for local development.

# Gnani.ai Prisma STT API Key (Required for speech-to-text)
GNANI_API_KEY=your-gnani-api-key-here

# Supabase Configuration (Optional for local-only, required for cloud persistence)
# Production Project Ref: ahjmjgiyljjkxvwoubdr
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Security and Hosting Configuration
# Required in production: set to true to enforce Supabase bearer token authentication
VIRASYA_REQUIRE_AUTH=false

# Allowed CORS origins (comma-separated or * for development)
# In production, set to: https://virasya-ai-gnani.vercel.app
VIRASYA_CORS_ORIGIN=http://localhost:5173,https://virasya-ai-gnani.vercel.app
