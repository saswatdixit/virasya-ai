# Virasya AI Backend Environment Variables
# Copy this file to virasya-ai/.env for local development.

# Gnani.ai Prisma STT API Key (Required for speech-to-text)
GNANI_API_KEY=your-gnani-api-key-here

# Supabase Configuration (Optional for local-only, required for cloud persistence)
# Production Project Ref: ahjmjgiyljjkxvwoubdr
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Server Host & Port Configuration
# When PORT is set (typical in cloud containers), the host automatically defaults to 0.0.0.0
PORT=5000
VIRASYA_WEB_HOST=0.0.0.0

# Security and Authentication
# In production, set to true to enforce Supabase Bearer token verification
VIRASYA_REQUIRE_AUTH=false

# Allowed CORS Origins (exact comma-separated origins, or * for open development)
# When set, only exact matching origins receive Access-Control-Allow-Origin headers.
# In production, set to your Vercel frontend URL:
VIRASYA_ALLOWED_ORIGINS=http://localhost:5173,https://virasya-ai-gnani.vercel.app
